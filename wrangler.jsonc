{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaveh",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "922c85b4-b1ee-4c22-a74e-9863c969dd50","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ebec1bfb33844335982abab628a6c1cd" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
